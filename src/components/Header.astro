---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
const normalizedBase = base.replace(/\/$/, '');
let path = Astro.url.pathname;
if (normalizedBase && path.startsWith(normalizedBase)) {
  path = path.slice(normalizedBase.length) || '/';
}
if (!path.startsWith('/')) path = `/${path}`;

const links = [
  { href: base, label: 'Home', match: (p: string) => p === '/' || p === '' },
  { href: `${base}apps/`, label: 'Apps', match: (p: string) => p.startsWith('/apps') },
  { href: `${base}privacy/`, label: 'Privacy', match: (p: string) => p.startsWith('/privacy') },
  { href: `${base}support/`, label: 'Support', match: (p: string) => p.startsWith('/support') },
];
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-ink/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-5 py-4">
    <a href={base} class="text-lg font-bold tracking-tight text-paper link-underline sm:text-xl">
      {site.brand}
    </a>
    <nav class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2 text-sm text-mist" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'link-underline transition-colors hover:text-paper',
              link.match(path) && 'text-paper',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
