---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-ink/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:gap-4 sm:px-5 sm:py-4">
    <a
      href={base}
      class="min-w-0 truncate text-base font-bold tracking-tight text-paper link-underline sm:text-xl"
    >
      {site.brand}
    </a>
    <a
      href={site.paypalUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 rounded-md bg-teal px-4 py-2.5 text-sm font-bold tracking-wide text-paper transition hover:bg-teal-dim sm:px-6 sm:py-3 sm:text-base"
    >
      Donate
    </a>
  </div>
</header>
