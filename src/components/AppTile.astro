---
import type { App } from '../data/apps';

interface Props {
  app: App;
  index?: number;
}

const { app, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const delayClass =
  index === 0 ? 'reveal-delay-1' : index === 1 ? 'reveal-delay-2' : 'reveal-delay-3';
---

<a
  href={`${base}apps/${app.slug}/`}
  class:list={[
    'reveal group flex flex-col gap-3 rounded-lg p-1 transition hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky',
    delayClass,
  ]}
>
  <div
    class="relative aspect-square w-full overflow-hidden rounded-2xl border border-white/10 shadow-[0_12px_40px_-20px_rgba(0,0,0,0.8)] transition group-hover:border-white/25"
    style={`background:linear-gradient(145deg, ${app.accent} 0%, color-mix(in srgb, ${app.accent} 55%, #12080a) 100%)`}
  >
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.22),transparent_45%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative flex h-full items-center justify-center">
      <span class="text-4xl font-bold tracking-tight text-paper/95 sm:text-5xl">{app.iconLabel}</span>
    </div>
  </div>
  <div class="px-1">
    <h2 class="text-base font-bold leading-snug text-paper sm:text-lg">{app.name}</h2>
    <p class="mt-1 text-sm text-mist">{app.tagline}</p>
  </div>
</a>
