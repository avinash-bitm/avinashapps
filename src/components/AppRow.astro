---
import type { App } from '../data/apps';

interface Props {
  app: App;
  index?: number;
}

const { app, index = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const delayClass =
  index === 0 ? 'reveal-delay-1' : index === 1 ? 'reveal-delay-2' : 'reveal-delay-3';
---

<article
  class:list={[
    'reveal group grid gap-4 border-b border-white/10 py-6 sm:grid-cols-[1fr_auto] sm:items-center sm:py-8',
    delayClass,
  ]}
>
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <h2 class="text-xl font-bold text-paper sm:text-3xl">
        <a class="link-underline" href={`${base}apps/${app.slug}/`}>{app.name}</a>
      </h2>
      <span
        class="rounded px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-paper"
        style={`background:${app.accent}`}
      >
        {app.tier}
      </span>
    </div>
    <p class="mt-2 max-w-xl text-sm text-mist sm:text-base">{app.tagline}</p>
  </div>
  <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap sm:gap-3">
    <a
      href={`${base}apps/${app.slug}/`}
      class="inline-flex w-full items-center justify-center rounded-md border border-white/15 px-4 py-2.5 text-sm font-semibold text-paper transition hover:border-sky/50 hover:text-sky sm:w-auto"
    >
      Details
    </a>
    <a
      href={app.playUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-full items-center justify-center rounded-md bg-paper px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-white sm:w-auto"
    >
      Get on Play
    </a>
  </div>
</article>
