---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Support" description="Contact and optional donations for Productivity apps.">
  <section class="mx-auto max-w-3xl px-4 py-10 sm:px-5 sm:py-20">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.14em] text-sky">Support</p>
    <h1 class="reveal reveal-delay-1 mt-3 text-3xl font-bold text-paper sm:text-5xl">
      Help &amp; contact
    </h1>
    <p class="reveal reveal-delay-2 mt-4 text-base text-mist sm:text-lg">
      Questions about an app? Reach out anytime. To donate, use the button at the top of the page.
    </p>

    <div class="reveal reveal-delay-3 mt-10">
      <h2 class="text-2xl font-bold text-paper">Contact</h2>
      <p class="mt-3 text-mist">
        Email
        <a class="link-underline text-sky hover:text-teal" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </section>
</BaseLayout>
