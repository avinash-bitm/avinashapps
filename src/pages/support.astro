---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const donateReady = site.paypalUrl.startsWith('http');
---

<BaseLayout title="Support" description="Contact and optional donations for Productivity apps.">
  <section class="mx-auto max-w-3xl px-5 py-16 sm:py-20">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.14em] text-teal">Support</p>
    <h1 class="reveal reveal-delay-1 mt-3 text-4xl font-bold text-paper sm:text-5xl">
      Help &amp; donate
    </h1>
    <p class="reveal reveal-delay-2 mt-4 text-lg text-mist">
      Questions about an app, or want to support future ones? You’re in the right place.
    </p>

    <div class="reveal reveal-delay-3 mt-10 space-y-10">
      <div>
        <h2 class="text-2xl font-bold text-paper">Contact</h2>
        <p class="mt-3 text-mist">
          Email
          <a class="link-underline text-teal hover:text-teal-dim" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>

      <div id="donate">
        <h2 class="text-2xl font-bold text-paper">Donate via PayPal</h2>
        <p class="mt-3 max-w-xl text-mist">
          Apps are free to use. If one is useful, an optional donation helps cover Play Console fees
          and build the next productivity tools. No pressure — only if you want to and can.
        </p>
        {
          donateReady ? (
            <a
              href={site.paypalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex rounded-md bg-teal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-teal-dim"
            >
              Donate via PayPal
            </a>
          ) : (
            <p class="mt-6 rounded-md border border-dashed border-white/20 bg-ink-2 px-4 py-3 text-sm text-mist">
              PayPal link coming soon. Update <code class="text-paper/90">paypalUrl</code> in
              <code class="text-paper/90">src/data/site.ts</code> when ready.
            </p>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>
