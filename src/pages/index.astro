---
import BaseLayout from '../layouts/BaseLayout.astro';
import Waveform from '../components/Waveform.astro';
import { site } from '../data/site';
import { apps } from '../data/apps';

const base = import.meta.env.BASE_URL;
const featured = apps[0];
---

<BaseLayout>
  <section class="relative isolate min-h-[calc(100vh-4.5rem)] overflow-hidden">
    <Waveform />
    <div class="relative mx-auto flex min-h-[calc(100vh-4.5rem)] max-w-5xl flex-col justify-end px-5 pb-16 pt-24 sm:pb-24">
      <p class="reveal font-display text-5xl font-extrabold tracking-tight text-paper sm:text-7xl md:text-8xl">
        {site.brand}
      </p>
      <h1 class="reveal reveal-delay-1 mt-5 max-w-xl font-display text-2xl font-semibold leading-snug text-paper/95 sm:text-3xl">
        Privacy-first Android apps that keep your audio on your device.
      </h1>
      <p class="reveal reveal-delay-2 mt-4 max-w-md text-base text-mist sm:text-lg">
        Start with {featured.name} — offline by design, no ads, no account.
      </p>
      <div class="reveal reveal-delay-3 mt-8 flex flex-wrap gap-3">
        <a
          href={`${base}apps/`}
          class="rounded-md bg-teal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-teal-dim"
        >
          View apps
        </a>
        <a
          href={`${base}support/#donate`}
          class="rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-paper transition hover:border-teal/60 hover:text-teal"
        >
          Donate
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
