---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppRow from '../components/AppRow.astro';
import { site } from '../data/site';
import { apps } from '../data/apps';

const base = import.meta.env.BASE_URL;
const donateHref = site.paypalUrl.startsWith('http')
  ? site.paypalUrl
  : `${base}support/#donate`;
const donateExternal = site.paypalUrl.startsWith('http');
---

<BaseLayout>
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_0%,rgba(45,212,191,0.14),transparent_50%),radial-gradient(ellipse_at_10%_60%,rgba(56,189,248,0.08),transparent_45%),linear-gradient(180deg,#0c1117_0%,#141b24_100%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-5 pt-14 pb-8 sm:pt-20 sm:pb-10">
      <h1 class="reveal text-4xl font-bold tracking-tight text-paper sm:text-5xl md:text-6xl">
        {site.brand}
      </h1>
      <p class="reveal reveal-delay-1 mt-4 max-w-xl text-lg text-mist sm:text-xl">
        Discover simple Android apps. Use them freely — donate only if you want to support more.
      </p>
      <div class="reveal reveal-delay-2 mt-6 flex flex-wrap gap-3">
        <a
          href="#apps"
          class="rounded-md bg-teal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-teal-dim"
        >
          Browse apps
        </a>
        <a
          href={donateHref}
          class="rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-paper transition hover:border-teal/60 hover:text-teal"
          {...(donateExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          Donate
        </a>
      </div>
    </div>
  </section>

  <section id="apps" class="relative mx-auto max-w-5xl px-5 pb-16 sm:pb-20">
    <div class="reveal border-t border-white/10 pt-10">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-teal">Apps</h2>
      <p class="mt-2 max-w-2xl text-mist">
        Start with any app below. More will appear here as they launch.
      </p>
    </div>
    <div class="mt-2">
      {apps.map((app, index) => <AppRow app={app} index={index} />)}
    </div>

    <div class="reveal mt-12 rounded-md border border-white/10 bg-ink-2 px-5 py-8 sm:px-8">
      <h2 class="text-xl font-bold text-paper sm:text-2xl">Like an app? Donate if you can</h2>
      <p class="mt-3 max-w-xl text-mist">
        Apps stay free to try. Optional donations help cover Play Console fees and fund the next tools.
      </p>
      <a
        href={donateHref}
        class="mt-6 inline-flex rounded-md bg-teal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-teal-dim"
        {...(donateExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        Donate via PayPal
      </a>
    </div>
  </section>
</BaseLayout>
