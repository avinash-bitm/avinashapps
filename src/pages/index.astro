---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppRow from '../components/AppRow.astro';
import { site } from '../data/site';
import { apps } from '../data/apps';
---

<BaseLayout>
  <section class="relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_80%_0%,rgba(139,21,56,0.28),transparent_50%),radial-gradient(ellipse_at_10%_70%,rgba(190,18,60,0.12),transparent_45%),linear-gradient(180deg,#12080a_0%,#1a0e11_100%)]"
      aria-hidden="true"
    >
    </div>

    <div class="relative mx-auto max-w-5xl px-4 pt-10 pb-6 sm:px-5 sm:pt-16 sm:pb-10">
      <h1 class="reveal text-3xl font-bold tracking-tight text-paper sm:text-5xl md:text-6xl">
        {site.brand}
      </h1>
      <p class="reveal reveal-delay-1 mt-3 max-w-xl text-base text-mist sm:mt-4 sm:text-xl">
        Discover simple Android apps. Use them freely — donate only if you want to support more.
      </p>
    </div>
  </section>

  <section id="apps" class="relative mx-auto max-w-5xl px-4 pb-12 sm:px-5 sm:pb-20">
    <div class="reveal border-t border-white/10 pt-8 sm:pt-10">
      <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-sky">Apps</h2>
      <p class="mt-2 max-w-2xl text-sm text-mist sm:text-base">
        Start with any app below. More will appear here as they launch.
      </p>
    </div>
    <div class="mt-2">
      {apps.map((app, index) => <AppRow app={app} index={index} />)}
    </div>
  </section>
</BaseLayout>
