---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppRow from '../../components/AppRow.astro';
import { apps } from '../../data/apps';
---

<BaseLayout title="Apps" description="Android productivity apps you can try — more coming soon.">
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-5 sm:py-20">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.14em] text-sky">Apps</p>
    <h1 class="reveal reveal-delay-1 mt-3 text-3xl font-bold text-paper sm:text-5xl">
      Discover apps
    </h1>
    <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-base text-mist sm:text-lg">
      Simple Android tools. Try them, and donate only if they help you.
    </p>
    <div class="mt-6">
      {apps.map((app, index) => <AppRow app={app} index={index} />)}
    </div>
  </section>
</BaseLayout>
