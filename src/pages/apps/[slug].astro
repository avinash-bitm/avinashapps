---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apps, getApp } from '../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug } }));
}

const { slug } = Astro.params;
const app = getApp(slug!);
if (!app) {
  return Astro.redirect(`${import.meta.env.BASE_URL}apps/`);
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={app.name} description={app.description}>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style={`background:radial-gradient(ellipse at 80% 0%, ${app.accent}33, transparent 50%)`}
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-4 py-10 sm:px-5 sm:py-20">
      <p class="reveal text-sm">
        <a class="link-underline text-mist hover:text-paper" href={`${base}apps/`}>Apps</a>
        <span class="text-mist/50"> / </span>
        <span class="text-mist">{app.shortName}</span>
      </p>
      <div class="reveal reveal-delay-1 mt-4 flex flex-wrap items-center gap-3 sm:gap-4">
        <img
          src={`${base}${app.icon}`}
          alt=""
          width="72"
          height="72"
          class="h-14 w-14 rounded-2xl border border-white/10 shadow-lg sm:h-[72px] sm:w-[72px]"
        />
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <h1 class="text-3xl font-bold text-paper sm:text-5xl">{app.name}</h1>
          <span
            class="rounded px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-paper"
            style={`background:${app.accent}`}
          >
            {app.tier}
          </span>
        </div>
      </div>
      <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-lg text-mist sm:text-xl">{app.tagline}</p>
      <p class="reveal reveal-delay-3 mt-5 max-w-2xl text-sm leading-relaxed text-paper/85 sm:text-base">
        {app.description}
      </p>
      <div class="mt-8 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:gap-3">
        <a
          href={app.playUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full items-center justify-center rounded-md bg-teal px-5 py-3 text-sm font-semibold text-paper transition hover:bg-teal-dim sm:w-auto"
        >
          Get on Google Play
        </a>
        <a
          href={`${base}privacy/`}
          class="inline-flex w-full items-center justify-center rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-paper transition hover:border-sky/60 sm:w-auto"
        >
          Privacy policy
        </a>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-2">
        <div>
          <h2 class="text-2xl font-bold text-paper">Features</h2>
          <ul class="mt-5 space-y-3 text-mist">
            {app.features.map((feature) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${app.accent}`} />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl font-bold text-paper">Privacy</h2>
          <ul class="mt-5 space-y-3 text-mist">
            {app.privacyHighlights.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${app.accent}`} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-mist/80">
            Package: <code class="rounded bg-ink-3 px-1.5 py-0.5 text-paper/90">{app.packageId}</code>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
