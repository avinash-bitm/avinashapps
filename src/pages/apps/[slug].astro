---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { apps, getApp } from '../../data/apps';

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug } }));
}

const { slug } = Astro.params;
const app = getApp(slug!);
if (!app) {
  return Astro.redirect(`${import.meta.env.BASE_URL}apps/`);
}

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={app.name} description={app.description}>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0 opacity-40"
      style={`background:radial-gradient(ellipse at 80% 0%, ${app.accent}33, transparent 50%)`}
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <p class="reveal text-sm">
        <a class="link-underline text-mist hover:text-paper" href={`${base}apps/`}>Apps</a>
        <span class="text-mist/50"> / </span>
        <span class="text-mist">{app.shortName}</span>
      </p>
      <div class="reveal reveal-delay-1 mt-4 flex flex-wrap items-center gap-3">
        <h1 class="font-display text-4xl font-bold text-paper sm:text-5xl">{app.name}</h1>
        <span
          class="rounded px-2 py-0.5 text-xs font-semibold uppercase tracking-wide text-ink"
          style={`background:${app.accent}`}
        >
          {app.tier}
        </span>
      </div>
      <p class="reveal reveal-delay-2 mt-4 max-w-2xl text-xl text-mist">{app.tagline}</p>
      <p class="reveal reveal-delay-3 mt-5 max-w-2xl text-base leading-relaxed text-paper/85">
        {app.description}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={app.playUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md bg-teal px-5 py-3 text-sm font-semibold text-ink transition hover:bg-teal-dim"
        >
          Get on Google Play
        </a>
        <a
          href={`${base}privacy/`}
          class="rounded-md border border-white/20 px-5 py-3 text-sm font-semibold text-paper transition hover:border-teal/60"
        >
          Privacy policy
        </a>
      </div>

      <div class="mt-16 grid gap-12 md:grid-cols-2">
        <div>
          <h2 class="font-display text-2xl font-bold text-paper">Features</h2>
          <ul class="mt-5 space-y-3 text-mist">
            {app.features.map((feature) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${app.accent}`} />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="font-display text-2xl font-bold text-paper">Privacy</h2>
          <ul class="mt-5 space-y-3 text-mist">
            {app.privacyHighlights.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full" style={`background:${app.accent}`} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-sm text-mist/80">
            Package: <code class="rounded bg-ink-3 px-1.5 py-0.5 text-paper/90">{app.packageId}</code>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
